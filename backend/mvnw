#!/bin/sh
# ----------------------------------------------------------------------------
# Maven Wrapper script for POSIX-compliant shells
# ----------------------------------------------------------------------------

export MAVEN_PROJECTBASEDIR="${MAVEN_BASEDIR:-$(pwd)}"

if [ -z "$JAVA_HOME" ]; then
  JAVACMD="java"
else
  JAVACMD="$JAVA_HOME/bin/java"
fi

if command -v mvn >/dev/null 2>&1; then
  exec mvn "$@"
fi

if [ -f "$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.jar" ]; then
  exec "$JAVACMD" -jar "$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.jar" "$@"
fi

echo "Please install Maven or ensure java is on your PATH." >&2
exit 1

