// ==========================================================
// BalanceVault - Prisma ORM Schema Definition
// Database: PostgreSQL 16
// ==========================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  ACCOUNT_HOLDER
  AUDITOR
  OPERATOR
}

enum AccountType {
  CUSTOMER_CHECKING
  CUSTOMER_SAVINGS
  SYSTEM_CLEARING
  MERCHANT_SETTLEMENT
  ESCROW
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER
  FEE_DEDUCTION
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

enum EntryType {
  DEBIT
  CREDIT
}

enum IdempotencyStatus {
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id        BigInt    @id @default(autoincrement())
  username  String    @unique @db.VarChar(50)
  password  String    @db.VarChar(255)
  email     String?   @db.VarChar(100)
  fullName  String?   @map("full_name") @db.VarChar(100)
  role      Role      @default(ACCOUNT_HOLDER)
  status    String    @default("ACTIVE") @db.VarChar(20)
  createdAt DateTime  @default(now()) @map("created_at")
  accounts  Account[]

  @@map("users")
}

model Account {
  id                  BigInt            @id @default(autoincrement())
  accountNumber       String            @unique @map("account_number") @db.VarChar(36)
  userId              BigInt?           @map("user_id")
  user                User?             @relation(fields: [userId], references: [id])
  name                String            @db.VarChar(100)
  balance             Decimal           @default(0.0000) @db.Decimal(19, 4)
  currency            String            @default("USD") @db.VarChar(3)
  accountType         AccountType       @map("account_type")
  status              String            @default("ACTIVE") @db.VarChar(20)
  version             BigInt            @default(0)
  createdAt           DateTime          @default(now()) @map("created_at")

  outgoingTransactions Transaction[]    @relation("SourceAccount")
  incomingTransactions Transaction[]    @relation("DestinationAccount")
  ledgerEntries        LedgerEntry[]

  @@index([accountNumber])
  @@index([userId])
  @@map("accounts")
}

model Transaction {
  id                   BigInt            @id @default(autoincrement())
  txUuid               String            @unique @map("tx_uuid") @db.VarChar(36)
  idempotencyKey       String?           @unique @map("idempotency_key") @db.VarChar(128)
  type                 TransactionType
  amount               Decimal           @db.Decimal(19, 4)
  currency             String            @default("USD") @db.VarChar(3)
  sourceAccountId      BigInt?           @map("source_account_id")
  sourceAccount        Account?          @relation("SourceAccount", fields: [sourceAccountId], references: [id])
  destinationAccountId BigInt?           @map("destination_account_id")
  destinationAccount   Account?          @relation("DestinationAccount", fields: [destinationAccountId], references: [id])
  description          String?           @db.VarChar(255)
  status               TransactionStatus @default(COMPLETED)
  createdAt            DateTime          @default(now()) @map("created_at")

  ledgerEntries        LedgerEntry[]

  @@index([txUuid])
  @@index([idempotencyKey])
  @@index([sourceAccountId])
  @@index([destinationAccountId])
  @@map("transactions")
}

model LedgerEntry {
  id            BigInt      @id @default(autoincrement())
  entryOrder    BigInt      @map("entry_order")
  transactionId BigInt      @map("transaction_id")
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  accountId     BigInt      @map("account_id")
  account       Account     @relation(fields: [accountId], references: [id])
  entryType     EntryType   @map("entry_type")
  amount        Decimal     @db.Decimal(19, 4)
  prevHash      String      @map("prev_hash") @db.VarChar(64)
  entryHash     String      @map("entry_hash") @db.VarChar(64)
  createdAt     DateTime    @default(now()) @map("created_at")

  @@index([entryOrder])
  @@index([transactionId])
  @@index([accountId])
  @@map("ledger_entries")
}

model IdempotencyRecord {
  id             BigInt            @id @default(autoincrement())
  idempotencyKey String            @unique @map("idempotency_key") @db.VarChar(128)
  requestHash    String            @map("request_hash") @db.VarChar(64)
  status         IdempotencyStatus @default(PROCESSING)
  httpStatus     Int?              @map("http_status")
  responseBody   String?           @map("response_body") @db.Text
  createdAt      DateTime          @default(now()) @map("created_at")

  @@index([idempotencyKey])
  @@map("idempotency_records")
}
